# =====================================================================
# LINGOSTREAM UNIVERSAL - ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Settings (Gunakan koma untuk beberapa domain, contoh: http://localhost:3000,http://10.0.2.2:8000)
# PERINGATAN: Di lingkungan produksi, batasi ke origin aplikasi Anda.
ALLOWED_ORIGINS=*

# Faster-Whisper ASR Configuration
# Opsi model: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Batasan Operasional
MAX_VIDEO_MINUTES=30
RATE_LIMIT_PER_MINUTE=60
CACHE_DIR=./cache
SQLITE_DB_PATH=./cache/lingostream_dictionary.sqlite3
